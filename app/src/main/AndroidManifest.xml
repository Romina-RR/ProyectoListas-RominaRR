<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".screens.listas.ListasActivity"
            android:exported="false"
            android:label="@string/title_activity_listas"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.listas.NuevaListaActivity"
            android:exported="false"
            android:label="@string/title_activity_nueva_lista"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.listas.ListaDetalleActivity"
            android:exported="false"
            android:label="@string/title_activity_lista_detalle"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.listas.NuevoProductoActivity"
            android:exported="false"
            android:label="@string/title_activity_nuevo_producto"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.catalogo.CatalogoActivity"
            android:exported="false"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.gastos.GastosActivity"
            android:exported="false"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.perfil.PerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.catalogo.EditarProductoActivity"
            android:exported="false"
            android:label="@string/title_activity_editar_producto"
            android:theme="@style/Theme.NCR1125_RODRIGUEZ_RIVAS_GLEIDI_ROMINA"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>